{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true
  },
  "include": [
    "eleventy.config.ts",
    "vite.config.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "test/**/*.mts",
    "types/**/*.d.ts"
  ]
}
